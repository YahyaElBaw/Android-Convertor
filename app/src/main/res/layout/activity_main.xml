<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clavier">

    <!-- Zone du haut (environ 45% de l'écran sur fond bleu turquoise uni) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zoneHaut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/zone_haut_bg"
        android:padding="16dp"
        app:layout_constraintHeight_percent="0.46"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Titre de l'application -->
        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titre_app"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ligne 1 : Devise Source et Montant -->
        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/tvTitre"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/spDeviseSource"
            app:layout_constraintBottom_toBottomOf="@id/spDeviseSource"
            app:layout_constraintStart_toEndOf="@id/spDeviseSource"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ligne soulignée sous le montant -->
        <View
            android:id="@+id/lineMontant"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/ligne_soulignement"
            app:layout_constraintTop_toBottomOf="@id/tvMontant"
            app:layout_constraintStart_toStartOf="@id/tvMontant"
            app:layout_constraintEnd_toEndOf="@id/tvMontant" />

        <!-- Bouton Inverser -->
        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_inverser"
            android:src="@drawable/ic_swap"
            app:layout_constraintTop_toBottomOf="@id/lineMontant"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/white" />

        <!-- Ligne 2 : Devise Cible et Résultat -->
        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/btnInverser"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="end"
            android:text=""
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/spDeviseCible"
            app:layout_constraintBottom_toBottomOf="@id/spDeviseCible"
            app:layout_constraintStart_toEndOf="@id/spDeviseCible"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ligne soulignée sous le résultat -->
        <View
            android:id="@+id/lineResultat"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/ligne_soulignement"
            app:layout_constraintTop_toBottomOf="@id/tvResultat"
            app:layout_constraintStart_toStartOf="@id/tvResultat"
            app:layout_constraintEnd_toEndOf="@id/tvResultat" />

        <!-- Bouton Convertir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConvertir"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_convertir"
            android:textColor="@color/bouton_convertir_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/bouton_convertir_bg"
            app:cornerRadius="24dp"
            app:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/lineResultat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Zone du bas : Clavier numérique personnalisé (TableLayout 4x3) -->
    <TableLayout
        android:id="@+id/tableClavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:stretchColumns="*"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/zoneHaut"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ligne 1 : 7, 8, 9 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 2 : 4, 5, 6 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 3 : 1, 2, 3 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 4 : C, 0, . -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btnC"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="C"
                android:textColor="@color/touche_c"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnPoint"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textColor="@color/clavier_chiffre"
                android:textSize="32sp"
                android:textStyle="bold" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
